# Create a private OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Use a long, unique password to protect the OpenCode HTTP server
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Enable Developer Mode in Discord, then copy the server, channel, and your user IDs.
DISCORD_GUILD_ID=replace-with-your-discord-server-id
DISCORD_ALLOWED_USER_IDS=replace-with-your-discord-user-id
DISCORD_ALLOWED_CHANNEL_IDS=replace-with-your-discord-channel-id

# Fine-grained GitHub PAT scoped only to selected repositories:
# Contents: Read and write; Issues and Pull requests: Read and write; Metadata: Read-only.
GITHUB_PERSONAL_ACCESS_TOKEN=replace-with-your-fine-grained-github-token

# Keep writes and destructive/admin operations disabled unless you need them.
DISCORD_ALLOW_WRITES=false
DISCORD_ALLOW_DESTRUCTIVE_ADMIN=false
