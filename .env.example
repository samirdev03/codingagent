# No static credentials are required by the default setup.
# Match the Obsidian container user to the server user's bind-mounted vault.
OBSIDIAN_UID=1000
OBSIDIAN_GID=1000
# GitHub MCP reads the server user's authenticated `gh` token at launch.
# Codex is authenticated to your ChatGPT account on the remote server.
# Obsidian MCP accesses the local Markdown vault; Obsidian Sync is optional.
